{
  "name": "tide-flow",
  "version": "1.1.0",
  "private": true,
  "description": "Open-source harmonic tide visualization for coastal locations worldwide",
  "license": "MIT",
  "author": "Vinh Nguyen",
  "homepage": "https://vinhnguyenthanhdn.github.io/tide-flow/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vinhnguyenthanhdn/tide-flow.git"
  },
  "bugs": {
    "url": "https://github.com/vinhnguyenthanhdn/tide-flow/issues"
  },
  "keywords": [
    "tide",
    "tidal-constituents",
    "harmonic-analysis",
    "global-tides",
    "data-visualization"
  ],
  "type": "module",
  "scripts": {
    "build": "npm run build:css && npm run build:vendor",
    "build:css": "tailwindcss -i ./src/input.css -o ./assets/tailwind.css --minify",
    "build:vendor": "node scripts/copy-vendor.mjs",
    "build:site": "npm run build && node scripts/prepare-site.mjs",
    "capture:social": "node scripts/capture-social-preview.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "serve": "serve . -p 3000 -s",
    "test:e2e": "playwright test",
    "test:all": "npm run build && npm test && npm run test:e2e"
  },
  "engines": {
    "node": ">=20.19"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@vitest/coverage-v8": "^4.1.10",
    "jsdom": "^29.1.1",
    "serve": "^14.0.0",
    "tailwindcss": "^3.4.19",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "alpinejs": "^3.16.0",
    "chart.js": "^4.5.1",
    "chartjs-plugin-zoom": "^2.2.0",
    "flatpickr": "^4.6.13",
    "hammerjs": "^2.0.8"
  }
}
